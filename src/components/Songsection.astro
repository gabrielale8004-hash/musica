---
import Songcard from "./Songcard.astro";
const { title, subtitle, songs } = Astro.props;
---

<section class="mb-12 px-2">
    <div class="mb-10">
        <div class="flex items-end gap-6 mb-2">
            <h2 class="text-4xl font-black italic tracking-tighter uppercase leading-none">{title}</h2>
            <div class="h-[1px] flex-1 bg-gradient-to-r from-blue-600 to-transparent mb-1.5 opacity-40"></div>
        </div>
        {subtitle && <p class="text-[9px] text-zinc-600 uppercase tracking-[0.4em] font-black italic">{subtitle}</p>}
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-10">
        {songs && songs.map((song: any) => (
            <Songcard song={song} />
        ))}
    </div>
</section>