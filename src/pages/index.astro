---
import Layout from "../layouts/layout.astro";
import Songcard from "../components/songcard.astro";

const response = await fetch('https://api.institutoalfa.org/api/songs');
const { songs } = await response.json();
---

<Layout>
  <div class="grid grid-cols-8 gap-4 p-14">
      {
        songs.map((song: any) => {
          return (
            <Songcard song={song} />
          )
        })
      }
    </div>
</Layout>