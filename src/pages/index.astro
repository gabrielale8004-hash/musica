---
import Layout from "../layouts/Layout.astro";
import Songsection from "../components/Songsection.astro";

const response = await fetch('https://api.institutoalfa.org/api/songs');
const { songs } = await response.json();
---

<Layout title="BOLT - Music">
  <div class="flex min-h-screen bg-[#060608] text-white selection:bg-blue-500/30 font-sans overflow-hidden">
    
    <aside class="w-64 border-r border-white/[0.05] bg-black fixed h-full hidden lg:flex flex-col z-30">
      <div class="p-10 mb-2 flex items-center gap-3.5 group cursor-pointer">
        <div class="relative w-11 h-11 flex items-center justify-center bg-blue-600 rounded-xl shadow-[0_0_20px_rgba(37,99,235,0.4)] border border-white/10 overflow-hidden">
            <span class="material-symbols-outlined text-white text-3xl font-black italic z-10">bolt</span>
        </div>
        <h1 class="text-2xl font-black text-white italic tracking-tighter uppercase leading-none">Music</h1>
      </div>
      
      <div class="flex-1 overflow-y-auto px-6 space-y-12 pt-4 custom-scrollbar">
        <section>
          <p class="text-[9px] font-black text-zinc-600 uppercase tracking-[0.3em] px-4 mb-5">Menú</p>
          <nav class="space-y-1">
            <a href="#" class="flex items-center gap-4 px-4 py-3 rounded-xl bg-blue-600 text-white font-bold text-xs shadow-lg transition-all">
              <span class="material-symbols-outlined text-xl">home</span> Inicio
            </a>
            <a href="#" class="flex items-center gap-4 px-4 py-3 rounded-xl text-zinc-500 hover:bg-white/5 hover:text-white transition-all text-xs group">
              <span class="material-symbols-outlined text-xl group-hover:text-blue-500">explore</span> Descubrir
            </a>
          </nav>
        </section>

        <section>
          <p class="text-[9px] font-black text-zinc-600 uppercase tracking-[0.3em] px-4 mb-5">Colección</p>
          <nav class="space-y-1 text-xs text-zinc-500">
            <a href="#" class="flex items-center gap-4 px-4 py-3 rounded-xl hover:bg-white/5 hover:text-white transition-all">
                <span class="material-symbols-outlined text-xl">favorite</span> Favoritos
            </a>
            <a href="#" class="flex items-center gap-4 px-4 py-3 rounded-xl hover:bg-white/5 hover:text-white transition-all">
                <span class="material-symbols-outlined text-xl">database</span> Archivo
            </a>
          </nav>
        </section>
      </div>

      <div class="p-12 mt-auto flex flex-col items-center border-t border-white/[0.03]">
          <span class="text-6xl font-black italic text-transparent bg-clip-text bg-gradient-to-b from-zinc-800 via-zinc-900 to-transparent select-none opacity-40">8</span>
          <p class="text-[8px] font-black text-zinc-800 uppercase tracking-[0.5em] -mt-3">Core System</p>
      </div>
    </aside>

    <main class="flex-1 lg:ml-64 pb-48">
      <header class="p-8 lg:p-14 max-w-[1700px] mx-auto">
        
        <div class="relative w-full h-[400px] rounded-[3.5rem] overflow-hidden mb-20 border border-white/[0.05] shadow-2xl group">
            <img src={songs[1]?.album.image.url} class="w-full h-full object-cover opacity-30 grayscale transition-all duration-[10s] group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-r from-[#060608] via-[#060608]/20 to-transparent z-10"></div>
            
            <div class="absolute inset-y-0 left-20 flex flex-col justify-center z-20">
                <div class="flex items-center gap-4 mb-8">
                    <span class="h-[1.5px] w-12 bg-blue-600"></span>
                    <span class="text-[10px] font-black text-blue-500 uppercase tracking-[0.4em]">Editorial Selection</span>
                </div>
                <h2 class="text-8xl font-black italic tracking-tighter mb-4 uppercase leading-[0.85] drop-shadow-2xl">WEEKLY<br/><span class="text-blue-600">INSIGHTS</span></h2>
                <p class="text-zinc-500 max-w-sm font-medium italic text-sm mt-4 opacity-80">Curaduría premium de música y hardware industrial.</p>
            </div>
        </div>

        <Songsection 
            title="Fresh Releases" 
            subtitle="Latest additions to the digital vault" 
            songs={songs} 
        />

      </header>
    </main>

    <footer class="fixed bottom-10 left-1/2 -translate-x-1/2 w-[85%] max-w-6xl lg:left-[calc(50%+128px)] z-[100]">
        <div class="bg-zinc-950/70 backdrop-blur-3xl border border-white/10 p-7 rounded-[2.5rem] shadow-[0_40px_80px_-20px_rgba(0,0,0,1)]">
            <div class="flex items-center justify-between gap-12 px-2">
                <div class="flex items-center gap-6 w-1/4">
                    <img id="p-img" src={songs[0]?.album.image.url} class="w-16 h-16 rounded-[1rem] shadow-2xl border border-white/5 object-cover" />
                    <div class="truncate">
                        <p id="p-title" class="text-[14px] font-black text-white truncate italic uppercase tracking-tight">{songs[0]?.title}</p>
                        <p id="p-artist" class="text-[9px] text-zinc-500 font-black uppercase tracking-[0.2em] mt-2 italic truncate opacity-80">{songs[0]?.artist}</p>
                    </div>
                </div>

                <div class="flex flex-col items-center gap-4 w-2/4">
                    <div class="flex items-center gap-14 text-zinc-500">
                        <button class="hover:text-white transition-all transform hover:scale-110"><span class="material-symbols-outlined text-2xl">skip_previous</span></button>
                        <button class="w-16 h-16 bg-white text-black rounded-full flex items-center justify-center hover:scale-105 active:scale-95 transition-all shadow-xl" id="p-play-btn">
                            <span class="material-symbols-outlined text-4xl font-fill" id="p-icon">play_arrow</span>
                        </button>
                        <button class="hover:text-white transition-all transform hover:scale-110"><span class="material-symbols-outlined text-2xl">skip_next</span></button>
                    </div>
                    
                    <div class="w-full flex items-center gap-6 px-4">
                        <span id="current-time" class="text-[10px] font-mono text-zinc-600 font-bold">0:00</span>
                        <div id="p-progress-container" class="h-1 flex-1 bg-white/5 rounded-full cursor-pointer relative">
                            <div id="p-progress" class="h-full w-0 bg-blue-600 rounded-full shadow-[0_0_15px_#2563eb]"></div>
                        </div>
                        <span id="total-duration" class="text-[10px] font-mono text-zinc-600 font-bold">0:00</span>
                    </div>
                </div>

                <div class="w-1/4 flex justify-end items-center gap-4 px-6">
                    <span class="material-symbols-outlined text-zinc-600">volume_up</span>
                    <input type="range" id="volume-slider" min="0" max="1" step="0.01" value="1" class="w-24 h-1 bg-white/10 rounded-full appearance-none cursor-pointer accent-blue-600" />
                </div>
            </div>
        </div>
    </footer>

    <audio id="main-audio"></audio>
  </div>

  <script>
    const audio = document.getElementById('main-audio') as HTMLAudioElement;
    const playBtn = document.getElementById('p-play-btn');
    const playIcon = document.getElementById('p-icon');
    const progressBar = document.getElementById('p-progress');
    const progressContainer = document.getElementById('p-progress-container');
    const cards = document.querySelectorAll('.song-card');
    const pImg = document.getElementById('p-img') as HTMLImageElement;
    const pTitle = document.getElementById('p-title');
    const pArtist = document.getElementById('p-artist');

    playBtn?.addEventListener('click', () => {
      if (!audio.src) return;
      if (audio.paused) { audio.play(); playIcon!.innerText = 'pause'; }
      else { audio.pause(); playIcon!.innerText = 'play_arrow'; }
    });

    cards.forEach(card => {
      card.addEventListener('click', () => {
        audio.src = card.getAttribute('data-url')!;
        pImg.src = card.getAttribute('data-image')!;
        pTitle!.innerText = card.getAttribute('data-title')!;
        pArtist!.innerText = card.getAttribute('data-artist')!;
        audio.play();
        playIcon!.innerText = 'pause';
      });
    });

    audio.addEventListener('timeupdate', () => {
      const percentage = (audio.currentTime / audio.duration) * 100;
      if(progressBar) progressBar.style.width = percentage + '%';
    });
  </script>
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap');
  body { font-family: 'Inter', sans-serif; background: #060608; overflow-x: hidden; }
  .font-fill { font-variation-settings: 'FILL' 1; }
  .custom-scrollbar::-webkit-scrollbar { width: 3px; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); }
</style>